OPENROUTER_API_KEY=
PRINTIFY_API_TOKEN=
# Optional — defaults to the first shop on the account
PRINTIFY_SHOP_ID=
# Optional — defaults to 99 (Printify Choice). Use 39 for SwiftPOD.
PRINTIFY_PRINT_PROVIDER_ID=
# Optional — Brand.dev / Context.dev API key for real logo + color lookup
# (BRAND_DEV_API_KEY and CONTEXT_DEV_API_KEY are both accepted)
BRAND_DEV_API_KEY=
# Optional — set to 1 to force Zero CLI Brand.dev lookup even when an API key is set
# BRAND_LOOKUP_VIA_ZERO=1
# Optional — set to 1 to skip brand lookup entirely (name-only inference)
# BRAND_LOOKUP_DISABLED=1
# Optional — multimodal design critic model (vision + OpenRouter web search via :online)
# DESIGN_CRITIC_MODEL=openai/gpt-5.5
# Optional — max print+mockup attempts in the approve/redo loop (1–5, default 3)
# DESIGN_REVIEW_MAX_ATTEMPTS=3
